<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>PrivateDeveloperInc.GuidFac</RootNamespace>
    <!-- The output stays in bin\<Configuration>\, as before, and not in bin\<Configuration>\net472\ -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The assembly attributes are in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The strong name key is the file that the environment variable DEVSNK names; build with -p:SignAssembly=false when you do not have it -->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(DEVSNK)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Label="VSIX">
    <!-- Sets the defaults of an SDK-style extension: the VSIX container, the Content items in it, F5 into the Experimental instance -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Visual Studio recognize the project as an extension before the first restore has imported the build tools -->
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <!-- The files are included by the globs of the SDK; this adds the metadata that Visual Studio needs for the designers, the generators and the nesting -->
  <ItemGroup>
    <Compile Update="GuidFacWindow.xaml.cs" DependentUpon="GuidFacWindow.xaml" />
    <Compile Update="Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
    <EmbeddedResource Update="Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" SubType="Designer" />
    <EmbeddedResource Update="VSPackage.resx" MergeWithCTO="true" ManifestResourceName="VSPackage" />
    <None Update="source.extension.vsixmanifest" SubType="Designer" />
    <Page Update="Resources\Styles.*.xaml" DependentUpon="Styles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <AvailableItemName Include="VSCTCompile" />
    <None Remove="GuidFac.vsct" />
    <VSCTCompile Include="GuidFac.vsct" ResourceName="Menus.ctmenu" SubType="Designer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content goes into the VSIX: VSSDKBuildToolsAutoSetup sets IncludeInVSIX for it. Resources\Images.png and Resources\Package.ico stay None items: the command table and VSPackage.resx read them while they build -->
    <Content Include="PreviewScreen.png" />
    <Content Include="ReleaseNotes.txt" />
    <Content Include="Resources\Icon_32x32.png" />
    <None Remove="PreviewScreen.png" />
    <None Remove="ReleaseNotes.txt" />
    <None Remove="Resources\Icon_32x32.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private assemblies of the Visual Studio that builds the extension: see "Private Visual Studio Assemblies" in the instructions. They must not be copied into the VSIX -->
    <Reference Include="Microsoft.VisualStudio.Diagnostics.Assert">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.Diagnostics.Assert.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Platform.WindowManagement">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\Microsoft.VisualStudio.Platform.WindowManagement.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.ViewManager">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\Microsoft.VisualStudio.Shell.ViewManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Framework assemblies that the SDK does not reference by default -->
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="stdole">
      <Guid>{00020430-0000-0000-C000-000000000046}</Guid>
      <VersionMajor>2</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>

</Project>
